# Environments and dependencies
.venv/
env/
venv/

# Python byte-code and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.env
.agents
.vscode/
*.egg-info/
build/
dist/

# Raw and processed datasets (kept local, not in Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Shared processed artifacts (needed to continue work on other machines)
!data/processed/tracks_aggregated.csv
!data/processed/tracks_normalized.csv
!data/processed/split_assignments.csv
!data/processed/split_genre_distribution.csv

# Trained models and heavy serialized artifacts (kept local / cloud storage)
models/*
!models/.gitkeep
*.joblib
*.pkl

